# AICOR environment template. Copy to .env and fill in locally.
# Never commit real values; GitHub Actions uses repository secrets instead.

# --- Backend service (backend/) ---
# Shared secret for GET|POST /api/refresh. Unset disables the endpoint (503).
CRON_SECRET=
AICOR_HOST=127.0.0.1
AICOR_PORT=8000
AICOR_DATA_DIR=web/public/data
AICOR_STALE_AFTER_SECONDS=21600
AICOR_REFRESH_INTERVAL_SECONDS=900
AICOR_REFRESH_TIMEOUT_SECONDS=2100
AICOR_SSE_HEARTBEAT_SECONDS=15
# Refuse new SSE connections beyond this many concurrent subscribers.
AICOR_MAX_SSE_SUBSCRIBERS=128
# Comma-separated exact origins. Use the real frontend origin in production;
# never use "*" with credentials or a private dashboard.
AICOR_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AICOR_AUTO_REFRESH=1
# Full local pipeline output is streamed here (one file per refresh job).
AICOR_LOG_DIR=logs
# Local mode: command used by the scheduler/manual refresh.
# AICOR_PIPELINE_COMMAND=python -m pipeline.run --mode full
# Optional data-sync hook run after a successful refresh, before the snapshot
# is reread. Required in GitHub dispatch mode if the daemon should serve the
# newly committed data (for example: git -C /srv/aicor pull --ff-only).
AICOR_POST_REFRESH_COMMAND=

# Optional: refresh through GitHub Actions instead of a local pipeline run.
# The token needs only actions:write on this repository.
GITHUB_TOKEN_DISPATCH=
AICOR_GITHUB_REPOSITORY=
AICOR_GITHUB_WORKFLOW=hourly-crawl.yml
AICOR_GITHUB_REF=main
# Seconds between polls of the dispatched workflow run.
AICOR_GITHUB_POLL_SECONDS=20

# --- Pipeline ---
# SEC requires a real project name and contact address.
SEC_USER_AGENT=
# Optional: enables the Tiingo adjusted-close cross-check.
TIINGO_API_KEY=
